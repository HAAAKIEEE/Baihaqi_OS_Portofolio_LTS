{
  "name": "baihaqi-os-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2025-02-24",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Setelah menjalankan `npx wrangler kv namespace create PORTFOLIO_KV`,
  // tempelkan blok ini dengan ID namespace Anda agar data Admin Panel tersimpan di Cloudflare KV:
  "kv_namespaces": [
    {
      "binding": "PORTFOLIO_KV",
      "id": "dd437329b0a346cda823a316afa2ca13"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
